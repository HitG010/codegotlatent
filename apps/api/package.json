{
  "name": "@cgl/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "problems:import": "tsx --env-file-if-exists=.env src/cli/import-problems.ts",
    "contests:create": "tsx --env-file-if-exists=.env src/cli/create-contest.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts"
  },
  "dependencies": {
    "@cgl/problem-package": "workspace:*",
    "@cgl/rating": "workspace:*",
    "@cgl/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "prisma": "7.10.0",
    "tsx": "^4.23.15"
  }
}
