// CodeGotLatent v2. Starts empty: nothing is migrated from v1.
//
// Problems are authored as ICPC-format packages (see packages/problem-package)
// and published here as immutable versions. Test files live in a blob store,
// addressed by SHA-256; this database only records their hashes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// Mirrors CONTEST_PHASES in @cgl/shared
enum ContestPhase {
  SCHEDULED
  GUESS_WINDOW
  LIVE
  JUDGING
  RESULTS
}

// Mirrors LANGUAGES in @cgl/shared
enum Language {
  cpp
  python
  javascript
  java
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  FINISHED
}

enum Verdict {
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
  INTERNAL_ERROR
}

enum RatingKind {
  LATENT
  FORM
}

// ─── People ──────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid(7))
  username          String    @unique
  // Set when the user picks their own handle; new accounts start with a generated one
  handleConfirmedAt DateTime?
  email             String    @unique
  googleId          String?   @unique
  role              Role      @default(USER)
  name              String?
  bio               String?
  location          String?

  latentRating   Int @default(1500)
  latentContests Int @default(0)
  formRating     Int @default(1500)
  formContests   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  participations ContestParticipant[]
  submissions    Submission[]
  progress       ProblemProgress[]
  ratingEvents   RatingEvent[]
}

// One row per signed-in device. Only a hash of the refresh token is stored.
model Session {
  id         String    @id @default(uuid(7))
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Problems ────────────────────────────────────────────────────────────

model Problem {
  id          String     @id @default(uuid(7))
  // The package's uuid from problem.yaml; survives renames and slug changes
  packageUuid String     @unique
  slug        String     @unique
  title       String
  difficulty  Difficulty
  // Listed in practice from this moment. Null while it's a draft or waiting
  // for its contest; the contest engine sets it when the contest ends.
  publishedAt DateTime?

  currentVersionId String? @unique

  // Maintained on each judged submission so the problem list is one cheap query
  submissionCount Int @default(0)
  acceptedCount   Int @default(0)
  solverCount     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currentVersion ProblemVersion?        @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions       ProblemVersion[]       @relation("Versions")
  tags           Tag[]
  contests       ContestProblem[]
  submissions    Submission[]
  progress       ProblemProgress[]
  contestResults ContestProblemResult[]

  @@index([publishedAt])
}

// An immutable snapshot of a published package. Fixing a statement typo or a
// test makes a new version; submissions keep pointing at the one they were
// judged against.
model ProblemVersion {
  id            String  @id @default(uuid(7))
  problemId     String
  number        Int // 1, 2, 3… within the problem
  packageHash   String
  // Rendered once at publish, so problem pages need no Markdown or KaTeX JS
  statementHtml String
  editorialHtml String?
  // [{ input, output }] for the problem page and the Run button
  samples       Json
  timeLimitMs   Int // for C++; other languages get LANGUAGES[*].timeMultiplier
  memoryLimitMb Int
  // A Checker from @cgl/shared
  checker       Json

  createdAt DateTime @default(now())

  problem     Problem       @relation("Versions", fields: [problemId], references: [id])
  currentOf   Problem?      @relation("CurrentVersion")
  tests       ProblemTest[]
  submissions Submission[]

  @@unique([problemId, number])
}

// Judged in ordinal order: samples first, then secret tests.
model ProblemTest {
  versionId  String
  ordinal    Int
  name       String // path under data/, e.g. "secret/03"
  isSample   Boolean
  inputHash  String
  answerHash String

  version ProblemVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  input   Blob           @relation("TestInput", fields: [inputHash], references: [hash])
  answer  Blob           @relation("TestAnswer", fields: [answerHash], references: [hash])

  @@id([versionId, ordinal])
}

// A file in the blob store, named by its SHA-256. A file shared by several
// tests, versions or problems is stored once.
model Blob {
  hash      String   @id
  size      Int
  createdAt DateTime @default(now())

  inputOf  ProblemTest[] @relation("TestInput")
  answerOf ProblemTest[] @relation("TestAnswer")
}

model Tag {
  id       String    @id @default(uuid(7))
  slug     String    @unique
  name     String    @unique
  problems Problem[]
}

// Practice progress, outside contests.
model ProblemProgress {
  userId         String
  problemId      String
  attempts       Int       @default(0)
  firstAttemptAt DateTime  @default(now())
  solvedAt       DateTime?

  user    User    @relation(fields: [userId], references: [id])
  problem Problem @relation(fields: [problemId], references: [id])

  @@id([userId, problemId])
  @@index([problemId])
}

// ─── Contests ────────────────────────────────────────────────────────────

model Contest {
  id          String       @id @default(uuid(7))
  slug        String       @unique
  title       String
  description String? // markdown
  rules       String? // markdown
  phase       ContestPhase @default(SCHEDULED)
  isPublic    Boolean      @default(true)
  isRated     Boolean      @default(true)

  guessOpensAt DateTime
  startsAt     DateTime
  endsAt       DateTime
  publishedAt  DateTime? // when results and ratings went out

  maxParticipants Int?
  penaltyMinutes  Int  @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problems     ContestProblem[]
  participants ContestParticipant[]
  submissions  Submission[]
  ratingEvents RatingEvent[]

  @@index([phase, startsAt])
}

// A problem's slot in a contest. A problem can appear in several contests
// (and later in private rooms) without being copied.
model ContestProblem {
  contestId String
  problemId String
  label     String // "A", "B", …
  points    Int

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id])

  @@id([contestId, problemId])
  @@unique([contestId, label])
}

model ContestParticipant {
  id           String   @id @default(uuid(7))
  contestId    String
  userId       String
  registeredAt DateTime @default(now())

  // Percentile range guess ("top best%–worst%"), locked during GUESS_WINDOW
  guessBest  Int?
  guessWorst Int?
  guessedAt  DateTime?

  // Live totals, kept in sync from ContestProblemResult
  score           Int @default(0)
  penaltyTimeMs   Int @default(0)
  solvedCount     Int @default(0)
  submissionCount Int @default(0)

  // Written once at JUDGING → RESULTS by @cgl/rating
  rank          Int?
  percentile    Float?
  intervalScore Float?
  latentDelta   Int?
  formDelta     Int?

  contest Contest                @relation(fields: [contestId], references: [id])
  user    User                   @relation(fields: [userId], references: [id])
  results ContestProblemResult[]

  @@unique([contestId, userId])
  @@index([userId])
  @@index([contestId, rank])
}

// One cell of the standings grid: a participant's state on one problem.
model ContestProblemResult {
  participantId String
  problemId     String
  // Rejected submissions before the first accept; later ones don't count
  wrongAttempts Int       @default(0)
  solvedAt      DateTime?

  participant ContestParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  problem     Problem            @relation(fields: [problemId], references: [id])

  @@id([participantId, problemId])
}

// ─── Judging and ratings ─────────────────────────────────────────────────

model Submission {
  id               String   @id @default(uuid(7))
  userId           String
  problemId        String
  problemVersionId String
  contestId        String?
  language         Language
  code             String

  status        SubmissionStatus @default(QUEUED)
  verdict       Verdict?
  testsPassed   Int              @default(0)
  testsTotal    Int              @default(0)
  timeMs        Int? // slowest test
  memoryKb      Int? // hungriest test
  // Per-test verdict, time and memory. Never includes hidden test data.
  results       Json?
  compileOutput String?

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  // Judging. Every claim by a worker bumps `attempts`, which doubles as a
  // fencing token: a worker whose claim was taken over can't write results.
  // `heartbeatAt` moves on as tests finish; a stale one means a dead worker.
  attempts    Int       @default(0)
  heartbeatAt DateTime?

  user           User           @relation(fields: [userId], references: [id])
  problem        Problem        @relation(fields: [problemId], references: [id])
  problemVersion ProblemVersion @relation(fields: [problemVersionId], references: [id])
  contest        Contest?       @relation(fields: [contestId], references: [id])

  @@index([userId, problemId, createdAt(sort: Desc)])
  // The queue: workers poll for the oldest QUEUED submission
  @@index([status, createdAt])
  @@index([problemId, verdict])
  @@index([contestId, createdAt])
}

// One row per rating change. The unique key makes publishing a contest's
// ratings idempotent: a retried publish can't apply a change twice.
model RatingEvent {
  id        String     @id @default(uuid(7))
  userId    String
  contestId String?
  kind      RatingKind
  before    Int
  after     Int
  createdAt DateTime   @default(now())

  user    User     @relation(fields: [userId], references: [id])
  contest Contest? @relation(fields: [contestId], references: [id])

  @@unique([userId, contestId, kind])
  @@index([userId, kind, createdAt])
}
