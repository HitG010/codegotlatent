# Copy to .env for local dev. Production values live in the host's secret store.
DATABASE_URL=postgresql://cgl:cgl@localhost:5433/cgl
# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=
CLIENT_ORIGIN=http://localhost:5173
# Web OAuth client from Google Cloud Console; add http://localhost:5173 to its JavaScript origins
GOOGLE_CLIENT_ID=
# Where problems:import stores test files locally
BLOB_DIR=.data/blobs
# Database tests truncate this one — never point it at real data
TEST_DATABASE_URL=postgresql://cgl:cgl@localhost:5433/cgl_test
PORT=4000
# go-judge sandbox: docker compose -f infra/docker-compose.yml up -d judge
JUDGE_URL=http://localhost:5050
# Set to run the sandbox tests locally
TEST_JUDGE_URL=http://localhost:5050
