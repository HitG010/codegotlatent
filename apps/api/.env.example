# Copy to .env for local dev. Production values live in the host's secret store.
DATABASE_URL=postgresql://cgl:cgl@localhost:5433/cgl
# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=
CLIENT_ORIGIN=http://localhost:5173
# Where problems:import stores test files locally
BLOB_DIR=.data/blobs
# Database tests truncate this one — never point it at real data
TEST_DATABASE_URL=postgresql://cgl:cgl@localhost:5433/cgl_test
PORT=5000
