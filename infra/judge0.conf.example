# Copy to judge0.conf and fill in real passwords (e.g. `openssl rand -hex 12`).
# judge0.conf is gitignored because it holds credentials.

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=

# --- Uncomment and set these before exposing Judge0 on a public VM ---
# AUTHN_HEADER=X-Auth-Token
# AUTHN_TOKEN=change-me-to-a-long-random-string
