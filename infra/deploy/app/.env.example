# Copy to .env (chmod 600). Generate secrets with: openssl rand -hex 32
# Hex keeps them safe inside URLs.

POSTGRES_PASSWORD=
ACCESS_TOKEN_SECRET=

# The web app's origin; the only one CORS allows, e.g. https://codegotlatent.com
CLIENT_ORIGIN=
# Web OAuth client ID from Google Cloud Console (same as the web app's)
GOOGLE_CLIENT_ID=

# The judge server's private IP, and the token set on it (infra/deploy/judge/.env)
JUDGE_URL=http://10.0.0.20:5050
JUDGE_TOKEN=
# Programs judged at once; match the judge server's cores
JUDGE_CONCURRENCY=2

# From Cloudflare Zero Trust > Networks > Tunnels, for a tunnel whose public
# hostname (e.g. api.codegotlatent.com) points at http://api:4000
TUNNEL_TOKEN=

# Image to run. Defaults to what CI publishes; `docker compose build` makes it locally.
# API_IMAGE=ghcr.io/hitg010/cgl-api:main

# Private problems repository checkout, for ./cgl import and ./cgl contest
PROBLEMS_DIR=/srv/cgl-problems
